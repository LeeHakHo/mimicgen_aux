#!/bin/bash
#SBATCH --account=biyik_1173
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --gres=gpu:1
#SBATCH --constraint=v100
# ONE architecture for every arm of every task, deliberately. A task's four arms only mean
# something against each other, and this project has already been bitten by mixed-GPU
# comparisons (the same checkpoint scored 46 vs 36 across architectures). v100 rather than
# a40 because the first arms happened to land there and because the v100 pool is the larger
# one (28 nodes vs 27) -- it costs 15-35% per epoch (12.5s vs 9.3s on the heaviest arm),
# which still finishes 500 epochs in ~1.8h against a 3h limit.
#SBATCH --mem=48G
#SBATCH --time=08:00:00
#SBATCH --job-name=mg_tr_id90
#SBATCH --array=0-47

# 12 tasks x 4 arms on the ID90 training distributions, 84px, 500 epochs.
#   array index -> task = idx / 4, arm = idx % 4
#   arm 0 baseline | 1 aux_world_frame | 2 aux_eef_frame | 3 aux_obj_eef_frame
# Configs come from mg_make_train_configs.py (save every 10 epochs, rollout n=1 rate=100 as a
# liveness check only -- all reported numbers come from the single unified eval job afterwards).
#
# No WANDB key here on purpose: the older job files carried one inline, which puts a credential in
# a committed file. The configs log to TensorBoard; for wandb, put the key in ~/.netrc and
# regenerate the configs with `mg_make_train_configs.py --wandb`.
#
# Submit subsets to spread across accounts, e.g.
#   sbatch --array=0-15  --account=biyik_1173  mg_train_id90_12task.job
#   sbatch --array=16-31 --account=gaurav_1048 mg_train_id90_12task.job
#   sbatch --array=32-47 --account=biyik_1165  mg_train_id90_12task.job
set -u
source /etc/profile.d/modules.sh; module purge; module load gcc/12.3.0
source /scratch1/hyeonhoo/miniconda3/etc/profile.d/conda.sh; conda activate robot_mimic_mg
export MUJOCO_GL=egl; export TMPDIR=/scratch1/hyeonhoo/tmp; mkdir -p "$TMPDIR"
export PYTHONUNBUFFERED=1 OPENBLAS_NUM_THREADS=1
cd /scratch1/hyeonhoo/code/Robomimic_Async

TASKS=(stack_d1 stack_three_d1 square_d2 threading_d0 three_piece_assembly_d0 hammer_cleanup_d1 \
       mug_cleanup_d1 coffee_d2 kitchen_d1 pick_place_d0 coffee_preparation_d1 nut_assembly_d0)
ARMS=(baseline aux_world_frame aux_eef_frame aux_obj_eef_frame)

T=${TASKS[$((SLURM_ARRAY_TASK_ID / 4))]}
A=${ARMS[$((SLURM_ARRAY_TASK_ID % 4))]}
# CFG_OVERRIDE lets a smoke run point at a modified config (e.g. rollout.rate lowered so a
# 20-epoch run actually exercises the rollout path) without touching the real ones.
CFG=${CFG_OVERRIDE:-robomimic/exps/templates/id90/${T}_id90_gmm_84.json}
NAME=${T}_${A}_id90_gmm_84
EPOCHS=${EPOCHS:-}          # e.g. EPOCHS=20 for a timing smoke

L3="--aux_head_layers 3"
FOLD1="--aux_rotation --aux_rotation_fold 1"
case "$A" in
    baseline)          AUX="" ;;
    aux_world_frame)   AUX="--aux_pose $FOLD1 $L3" ;;
    aux_eef_frame)     AUX="--aux_eef_frame $L3" ;;
    aux_obj_eef_frame) AUX="--aux_obj_eef_frame $L3" ;;
esac
# AUX_OVERRIDE replaces the arm's flags entirely (and NAME_SUFFIX keeps the run from colliding
# with the real one). Needed for the pc/voxel/tsdf arms, which are not in ARMS, and for smokes:
# robomimic deletes an existing experiment directory without asking, so two runs sharing a name
# is not a merge, it is one wiping the other mid-run.
[ -n "${AUX_OVERRIDE:-}" ] && AUX="$AUX_OVERRIDE"
NAME="${NAME}${NAME_SUFFIX:-}"

DS=$(python -c "import json;print(json.load(open('$CFG'))['train']['data'][0]['path'])")
[ -f "$CFG" ] || { echo "FATAL: config missing: $CFG (run mg_make_train_configs.py)" >&2; exit 1; }
[ -f "$DS" ]  || { echo "FATAL: dataset missing: $DS (datagen not finished for $T)" >&2; exit 1; }

echo "=== node: $(hostname) | idx $SLURM_ARRAY_TASK_ID -> task $T | arm $A ==="
echo "=== cfg $CFG | data $DS | aux: ${AUX:-<none>} ==="
nvidia-smi -L
python -c "import torch;print('cuda available:', torch.cuda.is_available())"

EXTRA=""
[ -n "$EPOCHS" ] && EXTRA="--num_epochs $EPOCHS"
python robomimic/scripts/train.py --config "$CFG" --name "$NAME" $AUX $EXTRA
echo "=== TRAIN EXIT: $? ($NAME) ==="
